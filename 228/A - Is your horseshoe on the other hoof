#include <bits/stdc++.h>
using namespace std;
 
int main()
{
    // your code goes here
    int a[4], count = 0;
    for (int i = 0; i < 4; i++)
    {
        cin >> a[i];
    }
    for (int i = 0; i < 3; i++)
    {
        for (int j = i + 1; j < 4; j++)
        {
            if (a[i] > a[j])
            {
                int temp;
                temp = a[j];
                a[j] = a[i];
                a[i] = temp;
            }
        }
    }
    for (int i = 0; i < 3; i++)
    {
        if (a[i] == a[i + 1])
            count++;
    }
    cout << count;
    return 0;
}